# OpenClaw Collector Configuration

# OpenClaw Gateway
OPENCLAW_GATEWAY_URL=wss://localhost:18789
OPENCLAW_API_URL=http://localhost:18789
OPENCLAW_TOKEN=your-token-here

# Storage
SQLITE_DB_PATH=./data/collector.db
REDIS_URL=redis://localhost:6379

# Collection Settings
COLLECTION_MODE=HYBRID_PRIORITY
FILE_WATCH_PATH=~/.openclaw/agents

# Logging
LOG_LEVEL=info
