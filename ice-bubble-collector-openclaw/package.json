{
  "name": "@ice-bubble/collector-openclaw",
  "version": "1.0.0",
  "description": "OpenClaw 数据采集服务 - 实时采集 Session 数据、Agent 状态和工具调用",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/start.ts",
    "build": "tsc",
    "start": "node dist/start.js",
    "test": "vitest run",
    "test:all": "vitest run",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:sqlite": "tsx tests/scripts/test-sqlite-manager.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "rebuild": "npm run clean && npm run build"
  },
  "keywords": [
    "openclaw",
    "collector",
    "websocket",
    "session",
    "agent"
  ],
  "author": "ice-bubble team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "better-sqlite3": "^9.4.0",
    "chokidar": "^3.5.0",
    "dotenv": "^16.4.0",
    "ioredis": "^5.3.0",
    "node-cron": "^3.0.0",
    "winston": "^3.11.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.0",
    "rimraf": "^5.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  }
}
