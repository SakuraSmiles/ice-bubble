{
  "name": "ice-bubble",
  "version": "1.2.1",
  "private": true,
  "description": "IceBubble - OpenClaw Desktop Manager",
  "workspaces": [
    "packages/*",
    "ice-bubble-admin",
    "ice-bubble-collector-openclaw",
    "ice-bubble-collector-opencode",
    "ice-bubble-desktop"
  ],
  "scripts": {
    "sync-version": "node scripts/sync-version.js",
    "postversion": "npm run sync-version",
    "build:all": "npm run build --workspaces --if-present",
    "start:admin": "cd ice-bubble-admin && npm start",
    "start:collector": "cd ice-bubble-collector-openclaw && npm start",
    "start:desktop": "cd ice-bubble-desktop && npm start"
  }
}
