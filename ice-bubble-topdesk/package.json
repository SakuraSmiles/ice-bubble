{
  "name": "@ice-bubble/topdesk",
  "version": "1.0.0",
  "description": "ice-bubble 桌面端展示应用",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx src/server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "build": "vue-tsc --noEmit && vite build",
    "start": "tsx src/server/index.ts",
