{
  "name": "@ice-bubble/logger",
  "version": "1.0.0",
  "description": "ice-bubble 统一结构化日志包（基于 Pino）",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "rebuild": "npm run clean && npm run build"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "dependencies": {
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0"
  }
}
