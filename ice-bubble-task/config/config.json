      "enabled": true,
      "taskStorePath": "/home/dabai/.openclaw/workspace/tasks/task-store.json"
    },
    "workbuddy": {
      "enabled": false,
      "baseUrl": "http://localhost:13103"
    },
    "claudeCode": {
      "enabled": false,
      "taskStorePath": "~/.claude/tasks/task-store.json"
    }
  },
  "scheduler": {
    "collectIntervalMs": 30000,
    "cleanupIntervalMs": 3600000,
    "taskTtlDays": 7
  }
}
