{
  "server": {
    "port": 13102,
    "host": "localhost"
  },
  "database": {
    "path": "../data/task.db",
    "walMode": true,
    "foreignKeys": false,
    "performance": {
      "cacheSize": -64000,
      "mmapSize": 268435456,
      "pageSize": 4096,
      "busyTimeout": 5000
    }
  },
  "collectors": {
