{
  "name": "@ice-bubble/desktop",
  "version": "1.0.0",
  "description": "ice-bubble \u684c\u9762\u7aef\u5c55\u793a\u5e94\u7528",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx src/server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "build": "vue-tsc --noEmit && vite build && npm run build:server",
    "start": "tsx src/server/index.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:server": "esbuild src/server/index.ts --platform=node --format=esm --outfile=dist-server/index.js"
  },
  "keywords": [
    "ice-bubble",
    "tauri",
    "vue3"
  ],
  "author": "SakuraSmiles",
  "license": "MIT",
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "element-plus": "^2.13.6",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.5",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/http-proxy-middleware": "^0.19.3",
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.0.0"
  }
}