# Ice Bubble Docker - Environment Variables
# Copy this file to .env and fill in your actual values
# ⚠️ NEVER commit .env to version control!

# === QQ Bot ===
QQBOT_API_BASE=https://your-qq-bot-api-base
QQBOT_TOKEN_URL=https://your-qq-bot-token-url
QQBOT_WS_PROXY_BASE=https://your-qq-bot-ws-proxy-base

# === AI API Keys ===
DEEPSEEK_API_KEY=your-deepseek-api-key

# === User/Host ===
UID=1000
GID=108
